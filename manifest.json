{
    "manifest_version": 3,
    "name": "Tami's (Vol.at) Paid Remover",
    "version": "1.0",
    "description": "Add the reading time to Chrome Extension documentation articles",
    "icons": {
        "32": "images/icon-32.png",
        "48": "images/icon-64.png",
        "128": "images/icon-128.png"
    },
    "content_scripts": [
        {
            "js": ["scripts/content.js"],
            "matches": [
                "https://www.vol.at/*"
            ]
        }
    ]
}