{
    "manifest_version": 3,
    "name": "Tami's (Vol.at) Paid Remover",
    "version": "1.0",
    "description": "Removes the Paid Articles on Vol.at",
    "icons": {
        "32": "images/icon-32.png",
        "48": "images/icon-64.png",
        "128": "images/icon-128.png"
    },
    "content_scripts": [
        {
            "js": ["scripts/content.js"],
            "matches": [
                "https://www.vol.at/*"
            ]
        }
    ]
}
